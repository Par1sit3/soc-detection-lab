#!/var/ossec/framework/python/bin/python3
"""Wazuh integration: forward an alert to the lab ticket queue.

wazuh-integratord runs this for every alert that matches the <integration>
block in the manager config, with: <alert file> <api key> <hook url>.
"""
import sys
import urllib.request
from datetime import datetime

LOG = "/var/ossec/logs/integrations.log"


def log(message):
    with open(LOG, "a") as handle:
        handle.write(f"{datetime.now():%Y/%m/%d %H:%M:%S} custom-ticket: {message}\n")


def main():
    if len(sys.argv) < 4:
        log("missing arguments")
        return 1
    alert_file, hook_url = sys.argv[1], sys.argv[3]
    try:
        with open(alert_file, "rb") as handle:
            payload = handle.read()
        request = urllib.request.Request(hook_url, data=payload, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(request, timeout=10) as response:
            log(f"sent alert, ticket service answered {response.status}: {response.read(200).decode(errors='replace')}")
    except Exception as error:  # never crash integratord over a ticketing outage
        log(f"failed to send alert: {error}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
